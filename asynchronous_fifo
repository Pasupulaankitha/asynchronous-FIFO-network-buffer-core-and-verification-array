module async_fifo #(
    parameter DATA_WIDTH = 8,
    parameter ADDR_WIDTH = 4
)
(
    input  wire wr_clk,
    input  wire rd_clk,
    input  wire reset,

    input  wire wr_en,
    input  wire rd_en,

    input  wire [DATA_WIDTH-1:0] data_in,
    output reg  [DATA_WIDTH-1:0] data_out,

    output wire full,
    output wire empty
);


localparam DEPTH = (1 << ADDR_WIDTH);


// FIFO Memory
reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];


// Binary Pointers
reg [ADDR_WIDTH:0] wr_ptr;
reg [ADDR_WIDTH:0] rd_ptr;


// Gray Pointers
reg [ADDR_WIDTH:0] wr_gray;
reg [ADDR_WIDTH:0] rd_gray;


// Synchronised Gray pointers
reg [ADDR_WIDTH:0] rd_gray_sync1, rd_gray_sync2;
reg [ADDR_WIDTH:0] wr_gray_sync1, wr_gray_sync2;


// Address
wire [ADDR_WIDTH-1:0] wr_addr;
wire [ADDR_WIDTH-1:0] rd_addr;

assign wr_addr = wr_ptr[ADDR_WIDTH-1:0];
assign rd_addr = rd_ptr[ADDR_WIDTH-1:0];


//---------------- WRITE LOGIC ----------------//

always @(posedge wr_clk or posedge reset)
begin
    if(reset)
    begin
        wr_ptr  <= 0;
        wr_gray <= 0;
    end

    else if(wr_en && !full)
    begin
        mem[wr_addr] <= data_in;

        wr_ptr <= wr_ptr + 1;
        wr_gray <= ( (wr_ptr + 1) >> 1 ) ^ (wr_ptr + 1);
    end
end



//---------------- READ LOGIC ----------------//

always @(posedge rd_clk or posedge reset)
begin
    if(reset)
    begin
        rd_ptr  <= 0;
        rd_gray <= 0;
        data_out <= 0;
    end

    else if(rd_en && !empty)
    begin
        data_out <= mem[rd_addr];

        rd_ptr <= rd_ptr + 1;
        rd_gray <= ((rd_ptr + 1)>>1) ^ (rd_ptr + 1);
    end
end



//---------------- CDC SYNCHRONIZER ----------------//

always @(posedge wr_clk or posedge reset)
begin
    if(reset)
    begin
        rd_gray_sync1 <= 0;
        rd_gray_sync2 <= 0;
    end

    else
    begin
        rd_gray_sync1 <= rd_gray;
        rd_gray_sync2 <= rd_gray_sync1;
    end
end



always @(posedge rd_clk or posedge reset)
begin
    if(reset)
    begin
        wr_gray_sync1 <= 0;
        wr_gray_sync2 <= 0;
    end

    else
    begin
        wr_gray_sync1 <= wr_gray;
        wr_gray_sync2 <= wr_gray_sync1;
    end
end



//---------------- FLAG LOGIC ----------------//

assign empty = (rd_gray == wr_gray_sync2);


// Full condition
assign full = 
(wr_gray == {~rd_gray_sync2[ADDR_WIDTH:ADDR_WIDTH-1],
             rd_gray_sync2[ADDR_WIDTH-2:0]});


endmodule
